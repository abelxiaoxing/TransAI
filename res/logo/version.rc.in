// VERSIONINFO for the Windows executable, so Explorer and the file properties
// dialog show the release version instead of an empty tab.
//
// Configured by CMake (@PROJECT_VERSION@) into the build directory: an .rc file
// needs literal numbers, compile definitions do not work here. The constants
// are spelled out instead of including <windows.h> because windres does not
// reliably find that header.

#define VS_VERSION_INFO     1
#define VFT_APP             0x00000001L
#define VOS_NT_WINDOWS32    0x00040004L
#define VS_FFI_FILEFLAGSMASK 0x0000003FL

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "AI translation utility"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "TransAI"
            VALUE "OriginalFilename", "TransAI.exe"
            VALUE "ProductName",      "TransAI"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
